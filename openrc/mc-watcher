#!/sbin/openrc-run

name="mc-watcher"
description="Minecraft server log watcher and notification daemon"
command="/usr/local/bin/mc-watcher"
command_user="main:main"
command_background=true
pidfile="/run/${RC_SVCNAME}.pid"

output_log="/var/log/mc-watcher.log"
error_log="/var/log/mc-watcher.log"

start_pre() {
    checkpath -d -m 0755 -o main:main /run
}

depend() {
    need localmount
    use net
}
